# Copy to .env. Comments must be on their own lines (docker env_file does not strip inline comments).

# --- Providers ---
# offline needs no keys (deterministic demo mode). Use openai or anthropic for real answers.
KB_LLM_PROVIDER=offline
# offline | openai   (pgvector store requires openai: 1536-dim vectors)
KB_EMBEDDING_PROVIDER=offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KB_OPENAI_CHAT_MODEL=gpt-4o-mini
KB_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KB_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Storage: memory | pgvector ---
KB_STORE=memory
DATABASE_URL=postgresql://kb:kb@db:5432/kb

# --- Retrieval tuning. Below KB_MIN_SCORE the assistant refuses instead of guessing ---
KB_TOP_K=4
KB_MIN_SCORE=0.22
KB_CHUNK_SIZE=900
KB_CHUNK_OVERLAP=150

# --- API security: comma-separated key:org pairs. Use long random keys in production ---
KB_API_KEYS=change-me:default
KB_RATE_LIMIT_PER_MIN=60
KB_COMPANY=Northwind Desk

# Demo only: index this folder for the "default" tenant at startup
KB_PRELOAD_DIR=sample_data/northwind
